# Copy this file to ".env" (same folder) and fill in one key.
#   copy .env.example .env
# Everything here is optional: indexing and search work with no keys at all.
# A real environment variable always overrides what is set here.

# --- Answer generation: set ONE of these ---------------------------------
# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Claude (https://console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=

# --- Optional overrides ---------------------------------------------------
# Force a provider instead of auto-detecting from the keys above:
# RAG_LLM_PROVIDER=gemini

# Use a specific model (defaults: gemini-3.8-flash / claude-opus-5 / openai/gpt-4o-mini):
# RAG_MODEL=gemini-3.5-flash-lite

# Lighter, faster models for a slow machine (see README):
# RAG_EMBED_MODEL=intfloat/multilingual-e5-small
# RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Turn reranking off entirely (faster, less accurate):
# RAG_RERANK=0
